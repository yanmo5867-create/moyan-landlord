<?xml version="1.0" encoding="UTF-8"?>
<project name="moyan-landlord" default="package" basedir=".">
    <property name="sdk.dir" value="./local-sdk" />
    <property name="target" value="android-25" />
    <property name="out.dir" value="bin" />
    <property name="apk.name" value="moyan-landlord-debug" />
    <path id="android.classpath">
        <pathelement path="${sdk.dir}/platforms/${target}/android.jar" />
    </path>
    <target name="clean">
        <delete dir="${out.dir}" />
        <mkdir dir="${out.dir}/classes" />
    </target>
    <target name="compile" depends="clean">
        <javac srcdir="src" destdir="${out.dir}/classes" classpathref="android.classpath" includeantruntime="false" />
    </target>
    <target name="package" depends="compile">
        <exec executable="${sdk.dir}/build-tools/25.0.3/aapt">
            <arg value="package" />
            <arg value="-f" />
            <arg value="-M" />
            <arg value="AndroidManifest.xml" />
            <arg value="-S" />
            <arg value="res" />
            <arg value="-I" />
            <arg value="${sdk.dir}/platforms/${target}/android.jar" />
            <arg value="-F" />
            <arg value="${out.dir}/${apk.name}.apk" />
        </exec>
        <echo message="APK生成完成：${out.dir}/${apk.name}.apk" />
    </target>
</project>
