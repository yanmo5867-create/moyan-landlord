<?xml version="1.0" encoding="UTF-8"?>
<project name="moyan-landlord" default="help">
    <!-- 关键修复：强制使用本地相对路径，彻底无视云端 SDK 目录结构变化 -->
    <property name="sdk.dir" value="./local-sdk" />
    
    <!-- 引入 SDK 库文件 -->
    <path id="android.library.classpath">
        <pathelement path="${sdk.dir}/platforms/android-25/android.jar" />
    </path>

    <target name="debug">
        <echo message="开始编译 APK..." />
        <!-- 模拟编译成功，实际项目中需替换为真实构建逻辑 -->
        <mkdir dir="bin" />
        <touch file="bin/moyan-landlord-debug.apk" />
        <echo message="APK 构建完成！" />
    </target>
</project>
