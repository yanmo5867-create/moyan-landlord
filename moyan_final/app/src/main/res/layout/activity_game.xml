<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_table"
    android:keepScreenOn="true">

    <!-- 特效层（最底层，全屏覆盖） -->
    <FrameLayout
        android:id="@+id/effectLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"/>

    <!-- 主对局界面 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 顶部信息栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#88000000"
            android:padding="6dp">

            <!-- 左侧AI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvLeftAIName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI上家"
                    android:textColor="#FF8888"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvLeftAIHandCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17张"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- 中间信息 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvMultiplier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="倍数: 1"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对局开始"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>
                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20"
                    android:textColor="#00FF00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- 右侧AI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvRightAIName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI下家"
                    android:textColor="#8888FF"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvRightAIHandCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17张"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 出牌展示区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_play_area"
            android:layout_marginVertical="4dp">

            <!-- 左侧AI出的牌 -->
            <TextView
                android:id="@+id/tvLeftPlayed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#FFAAAA"
                android:textSize="12sp"
                android:padding="4dp"/>

            <!-- 中间底牌/提示 -->
            <TextView
                android:id="@+id/tvCenterInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:padding="4dp"/>

            <!-- 右侧AI出的牌 -->
            <TextView
                android:id="@+id/tvRightPlayed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#AAAAFF"
                android:textSize="12sp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- 记牌器 -->
        <TextView
            android:id="@+id/tvCardCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="记牌器: 点击设置开启"
            android:textColor="#88FF88"
            android:textSize="11sp"
            android:background="#44000000"
            android:padding="4dp"
            android:gravity="center"/>

        <!-- 玩家手牌区 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/handCardArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="4dp"/>
        </HorizontalScrollView>

        <!-- 底部操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="6dp">

            <Button
                android:id="@+id/btnPass"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="过牌"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#757575"
                android:layout_marginEnd="20dp"/>

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="出牌"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                android:layout_marginEnd="20dp"/>

            <Button
                android:id="@+id/btnHint"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="提示"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2"/>
        </LinearLayout>

        <!-- 玩家手牌数 -->
        <TextView
            android:id="@+id/tvPlayerHandCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手牌: 17"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="2dp"/>

    </LinearLayout>

</FrameLayout>
